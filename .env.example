# Copy to .env. Never commit API keys.
# Required only for model-backed OpenAI runs; mock/demo runs need no API key.
OPENAI_API_KEY=

# Optional ElevenLabs narration. Set both values to enable it.
# When absent, replay uses the browser's available English/Korean voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Non-secret runtime defaults (model, language, host, port, and output paths)
# are configured in shells/env.sh or exported in your shell.
